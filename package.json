{
  "name": "hazento",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.api.json && vite build --config vite.config.ts",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "test:demo-migration": "node --experimental-strip-types scripts/validate-demo-id-migration.mjs",
    "test:planning-dates": "node --experimental-strip-types scripts/validate-planning-dates.mjs",
    "test:supabase-repository": "node --env-file=.env.local scripts/validate-supabase-repository-e2e.mjs",
    "test:service-catalog": "node --env-file=.env.local scripts/validate-service-catalog.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@mercadopago/sdk-react": "1.0.7",
    "@supabase/supabase-js": "2.55.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "6.4.3"
  }
}
